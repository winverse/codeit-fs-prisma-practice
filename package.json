{
  "name": "codeit-fs-prisma-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "prisma validate --schema src/practices/02-prisma-model-relations/prisma/schema.prisma && node --test test/problems.test.js",
    "test:answers": "prisma validate --schema src/practices/02-prisma-model-relations/answers/prisma/schema.prisma && node --test scripts/verify-answers.js",
    "check:02": "prisma validate --schema src/practices/02-prisma-model-relations/prisma/schema.prisma && node --test --test-name-pattern=\"^02 \" test/problems.test.js",
    "check:03": "node --test --test-name-pattern=\"^03 \" test/problems.test.js",
    "check:04": "node --test --test-name-pattern=\"^04 \" test/problems.test.js",
    "check:05": "node --test --test-name-pattern=\"^05 \" test/problems.test.js",
    "check:06": "node --test --test-name-pattern=\"^06 \" test/problems.test.js",
    "check:07": "node --test --test-name-pattern=\"^07 \" test/problems.test.js",
    "check:08": "node --test --test-name-pattern=\"^08 \" test/problems.test.js",
    "check:09": "node --test --test-name-pattern=\"^09 \" test/problems.test.js",
    "check:10": "node --test --test-name-pattern=\"^10 \" test/problems.test.js",
    "verify:prisma-schema": "prisma validate --schema src/practices/02-prisma-model-relations/prisma/schema.prisma",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1"
  }
}
