{
  "name": "codeit-fs-prisma-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#db/*": "./src/db/*"
  },
  "scripts": {
    "db:reset": "node --env-file=./env/.env.development scripts/reset-practice-database.js",
    "db:setup": "npm run prisma:migrate && npm run prisma:generate",
    "prisma:generate": "dotenv -e ./env/.env.development -- prisma generate",
    "prisma:generate:practice01": "dotenv -e ./env/.env.development -- prisma generate --schema src/practices/01-prisma-model-relations/prisma/schema.prisma",
    "prisma:generate:answer01": "dotenv -e ./env/.env.development -- prisma generate --schema src/practices/01-prisma-model-relations/answers/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ./env/.env.development -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ./env/.env.development -- prisma studio",
    "test": "npm run verify:prisma-schema && npm run test:infrastructure && node --test test/problems.test.js && npm run prisma:generate:practice01 && npm run test:schema && npm run test:database",
    "test:infrastructure": "node --test test/infrastructure.test.js",
    "test:schema": "node --env-file=./env/.env.development --test --test-concurrency=1 test/integration/schema-problem.integration.test.js",
    "test:database": "node --env-file=./env/.env.development --test --test-concurrency=1 test/integration/problems.integration.test.js",
    "test:answers": "dotenv -e ./env/.env.development -- prisma validate --schema src/practices/01-prisma-model-relations/answers/prisma/schema.prisma && npm run test:infrastructure && node --test scripts/verify-answers.js && npm run prisma:generate:answer01 && npm run test:schema:answers && npm run test:database:answers",
    "test:schema:answers": "node --env-file=./env/.env.development --test --test-concurrency=1 scripts/verify-schema-answer.js",
    "test:database:answers": "node --env-file=./env/.env.development --test --test-concurrency=1 scripts/verify-database-answers.js",
    "check:01": "npm run verify:prisma-schema && node --test --test-name-pattern=\"^01 \" test/problems.test.js && npm run prisma:generate:practice01 && npm run test:schema",
    "check:02": "node --test --test-name-pattern=\"^02 \" test/problems.test.js && node --env-file=./env/.env.development --test --test-concurrency=1 --test-name-pattern=\"^02 \" test/integration/problems.integration.test.js",
    "check:03": "node --test --test-name-pattern=\"^03 \" test/problems.test.js && node --env-file=./env/.env.development --test --test-concurrency=1 --test-name-pattern=\"^03 \" test/integration/problems.integration.test.js",
    "check:04": "node --test --test-name-pattern=\"^04 \" test/problems.test.js && node --env-file=./env/.env.development --test --test-concurrency=1 --test-name-pattern=\"^04 \" test/integration/problems.integration.test.js",
    "check:05": "node --test --test-name-pattern=\"^05 \" test/problems.test.js && node --env-file=./env/.env.development --test --test-concurrency=1 --test-name-pattern=\"^05 \" test/integration/problems.integration.test.js",
    "check:06": "node --test --test-name-pattern=\"^06 \" test/problems.test.js",
    "check:07": "node --test --test-name-pattern=\"^07 \" test/problems.test.js",
    "check:08": "node --test --test-name-pattern=\"^08 \" test/problems.test.js && node --env-file=./env/.env.development --test --test-concurrency=1 --test-name-pattern=\"^08 \" test/integration/problems.integration.test.js",
    "verify:prisma-schema": "dotenv -e ./env/.env.development -- prisma validate --schema src/practices/01-prisma-model-relations/prisma/schema.prisma",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1"
  }
}
